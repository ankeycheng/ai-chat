# Local development (single process): SQLite + in-memory broker.
# cp .env.dev.example .env   (backend/.env is git-ignored)
APP_PROFILE=dev
DB_BACKEND=sqlite
SQLITE_PATH=./data/ai-chat.db
BROKER_BACKEND=memory
RUN_MIGRATIONS_ON_STARTUP=true
DEEPSEEK_API_KEY=
# Switch to the production stack locally:
# APP_PROFILE=prod
# DB_BACKEND=postgres
# DATABASE_URL=postgresql://ai_chat:ai_chat@localhost:5432/ai_chat
# BROKER_BACKEND=redis
# REDIS_URL=redis://localhost:6379/0
# Offline development without a key:
# LLM_PROVIDER=fake
# SEARCH_PROVIDER=fake
