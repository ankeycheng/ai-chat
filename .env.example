# ---- copy to .env (never commit .env) -------------------------------------------
# Required
DEEPSEEK_API_KEY=
POSTGRES_PASSWORD=change-me-to-a-strong-password

# Optional (defaults shown)
HTTP_PORT=9123
BACKEND_REPLICAS=1
# Postgres role/db: ai_chat (underscore). Project/compose/images use ai-chat; hyphen invalid in PG identifiers.
POSTGRES_USER=ai_chat
POSTGRES_DB=ai_chat
DEEPSEEK_MODEL=deepseek-flash
DEEPSEEK_TITLE_MODEL=deepseek-flash
REASONING_EFFORT=high
SEARCH_PROVIDER=deepseek
LOG_LEVEL=INFO
# Only needed when the UI is served from a different origin than the API
CORS_ORIGINS=
